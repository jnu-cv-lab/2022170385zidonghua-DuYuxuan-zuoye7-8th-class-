{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug C++ OpenCV",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}/build/main",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [
                { "name": "DEBUGINFOD_URLS", "value": "" }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "为 gdb 启用整齐打印",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "关闭自动下载调试符号 (彻底解决蓝字卡死问题)",
                    "text": "set debuginfod enabled off",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build C++ with OpenCV",
            "miDebuggerPath": "/usr/bin/gdb"
        }
    ]
}